}

function setStatus(id, status, btn) {
const issue = state.issues.find(i=>i.id===id);
if(issue) issue.status = status;
document.querySelectorAll(’.status-btn’).forEach(b=>b.classList.remove(‘sel’));
btn.classList.add(‘sel’);
}

function saveDetail(id) {
const issue = state.issues.find(i=>i.id===id);
if(issue) {
issue.cost = document.getElementById(‘det-cost’)?.value || issue.cost;
issue.note = document.getElementById(‘det-note’)?.value || issue.note;
}
save();
closeDetail();
renderAll();
showToast(‘✅ התקלה עודכנה!’);
}

function closeDetail() {
showScreen(state.previousScreen || ‘app-admin’);
renderAll();
}

// ==================== ADD DATA ====================
function addIssue() {
const title = document.getElementById(‘ni-title’).value.trim();
if(!title) { showToast(‘❌ הכנס נושא לתקלה’); return; }
const today = new Date().toLocaleDateString(‘he-IL’);
state.issues.unshift({ id: Date.now(), title, location: document.getElementById(‘ni-location’).value, status:‘open’, reporter:‘ועד בית’, apt:’—’, date:today, desc: document.getElementById(‘ni-desc’).value });
save(); renderAll(); closeModal(‘modal-new-issue’);
document.getElementById(‘ni-title’).value = ‘’; document.getElementById(‘ni-desc’).value = ‘’;
showToast(‘✅ התקלה נשמרה!’);
}

function addTenantIssue() {
const title = document.getElementById(‘ti-title’).value.trim();
if(!title) { showToast(‘❌ הכנס נושא לתקלה’); return; }
const today = new Date().toLocaleDateString(‘he-IL’);
state.issues.unshift({ id: Date.now(), title, location: document.getElementById(‘ti-location’).value, status:‘open’, reporter:‘דייר’, apt:’—’, date:today, desc: document.getElementById(‘ti-desc’).value });
save(); closeModal(‘modal-tenant-issue’); renderTenantIssues();
document.getElementById(‘ti-title’).value = ‘’; document.getElementById(‘ti-desc’).value = ‘’;
showToast(‘✅ הדיווח נשלח לוועד!’);
}

function addPayment() {
const amount = parseFloat(document.getElementById(‘np-amount’).value);
if(!amount) { showToast(‘❌ הכנס סכום’); return; }
const today = new Date().toLocaleDateString(‘he-IL’);
state.payments.unshift({ id: Date.now(), supplier: document.getElementById(‘np-supplier’).value, amount, date:today, method: document.getElementById(‘np-method’).value });
save(); renderAll(); closeModal(‘modal-new-payment’);
document.getElementById(‘np-amount’).value = ‘’;
showToast(‘✅ התשלום נרשם!’);
}

function addSupplier() {
const name = document.getElementById(‘ns-name’).value.trim();
if(!name) { showToast(‘❌ הכנס שם ספק’); return; }
state.suppliers.push({ id: Date.now(), name, service: document.getElementById(‘ns-service’).value, phone: document.getElementById(‘ns-phone’).value, terms: document.getElementById(‘ns-terms’).value });
save(); renderAll(); closeModal(‘modal-new-supplier’);
document.getElementById(‘ns-name’).value = ‘’; document.getElementById(‘ns-phone’).value = ‘’;
showToast(‘✅ הספק נוסף!’);
}

// ==================== SETTINGS ====================
function changeAdminPass() {
const cur = document.getElementById(‘cp-current’).value;
const nw = document.getElementById(‘cp-new’).value;
const conf = document.getElementById(‘cp-confirm’).value;
const err = document.getElementById(‘cp-error’);
if(cur !== state.adminPass) { err.textContent=‘❌ הסיסמה הנוכחית שגויה’; err.classList.add(‘show’); return; }
if(nw !== conf) { err.textContent=‘❌ הסיסמות אינן תואמות’; err.classList.add(‘show’); return; }
if(nw.length < 4) { err.textContent=‘❌ הסיסמה קצרה מדי’; err.classList.add(‘show’); return; }
state.adminPass = nw; save();
closeModal(‘modal-change-pass’);
document.getElementById(‘cp-current’).value=’’; document.getElementById(‘cp-new’).value=’’; document.getElementById(‘cp-confirm’).value=’’;
showToast(‘✅ סיסמת האדמין עודכנה!’);
}

function changeTenantPass() {
const nw = document.getElementById(‘tp-new’).value;
const conf = document.getElementById(‘tp-confirm’).value;
if(nw !== conf) { showToast(‘❌ הסיסמות אינן תואמות’); return; }
if(nw.length < 4) { showToast(‘❌ הסיסמה קצרה מדי’); return; }
state.tenantPass = nw; save();
closeModal(‘modal-change-tenant-pass’);
showToast(‘✅ סיסמת הדיירים עודכנה!’);
}

function saveBuilding() {
closeModal(‘modal-building’);
showToast(‘✅ פרטי הבניין נשמרו!’);
}

// ==================== MODAL / TOAST ====================
function openModal(id) { document.getElementById(id).classList.add(‘open’); }
function closeModal(id) { document.getElementById(id).classList.remove(‘open’); }
document.querySelectorAll(’.modal-overlay’).forEach(m => {
m.addEventListener(‘click’, e => { if(e.target===m) m.classList.remove(‘open’); });
});

let toastTimer;
function showToast(msg) {
const t = document.getElementById(‘toast’);
t.textContent = msg; t.classList.add(‘show’);
clearTimeout(toastTimer);
toastTimer = setTimeout(()=>t.classList.remove(‘show’), 2500);
}

// ==================== INIT ====================
renderAll();
</script>

