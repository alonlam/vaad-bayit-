<script>
// ==================== STATE ====================
let state = {
  adminPass: localStorage.getItem('adminPass') || 'vaad2024',
  tenantPass: localStorage.getItem('tenantPass') || 'diur2024',
  currentRole: null,
  previousScreen: null,
  issues: JSON.parse(localStorage.getItem('issues') || 'null') || [
    { id:1, title:'רטיבות בתקרת הכניסה', location:'כניסה ראשית', status:'open', reporter:'דן כהן', apt:'4', date:'28/04/2026', desc:'כתם רטיבות גדול ליד הנורה' },
    { id:2, title:'מעלית תקועה בקומה 3', location:'מעלית', status:'in_progress', reporter:'שרה לוי', apt:'12', date:'26/04/2026', desc:'המעלית לא עולה לקומה 3', supplier:'טכנאי מעליות פז' },
    { id:3, title:'נורה שרופה בחניון', location:'חניון', status:'closed', reporter:'רון מזרחי', apt:'7', date:'20/04/2026', desc:'נורה שרופה בכניסה לחניון', cost:'85' },
    { id:4, title:'ברז דולף ליד תיבות הדואר', location:'כניסה ראשית', status:'open', reporter:'מיכל גל', apt:'2', date:'29/04/2026', desc:'ברז קטן דולף ליצור שלולית' },
  ],
  suppliers: JSON.parse(localStorage.getItem('suppliers') || 'null') || [
    { id:1, name:'יוסי האינסטלטור', service:'אינסטלציה', phone:'050-1234567', terms:'שוטף+30' },
    { id:2, name:'נקיון הבניין בע״מ', service:'ניקיון', phone:'054-9876543', terms:'מזומן' },
    { id:3, name:'טכנאי מעליות פז', service:'מעליות', phone:'052-3456789', terms:'שוטף+60' },
    { id:4, name:'גינון ירוק', service:'גינון', phone:'053-1122334', terms:'מזומן' },
  ],
  payments: JSON.parse(localStorage.getItem('payments') || 'null') || [
    { id:1, supplier:'נקיון הבניין בע״מ', amount:800, date:'28/04/2026', method:'העברה' },
    { id:2, supplier:'טכנאי מעליות פז', amount:1800, date:'25/04/2026', method:'שוטף+60' },
    { id:3, supplier:'גינון ירוק', amount:550, date:'20/04/2026', method:'מזומן' },
    { id:4, supplier:'יוסי האינסטלטור', amount:320, date:'15/04/2026', method:'העברה' },
  ],
  issueFilter: 'all',
  viewingIssue: null,
};

const statusLabel = { open:'פתוחה', in_progress:'בטיפול', closed:'סגורה' };
const statusClass = { open:'open', in_progress:'progress', closed:'closed' };
const serviceIcon = { 'אינסטלציה':'🔧','ניקיון':'✨','מעליות':'🛗','גינון':'🌿','חשמל':'⚡','אחר':'🔨' };

function save() {
  localStorage.setItem('issues', JSON.stringify(state.issues));
  localStorage.setItem('suppliers', JSON.stringify(state.suppliers));
  localStorage.setItem('payments', JSON.stringify(state.payments));
  localStorage.setItem('adminPass', state.adminPass);
  localStorage.setItem('tenantPass', state.tenantPass);
}

// ==================== LOGIN ====================
let selectedRole = null;
function selectRole(role) {
  selectedRole = role;
  document.getElementById('role-admin').classList.toggle('selected', role==='admin');
  document.getElementById('role-tenant').classList.toggle('selected', role==='tenant');
  const lbl = role==='admin' ? 'סיסמת ועד בית' : 'סיסמת דיירים';
  document.getElementById('pass-label').textContent = lbl;
  document.getElementById('password-input').style.display = 'block';
  document.getElementById('password-input').placeholder = '••••••••';
  document.getElementById('login-btn').style.display = 'block';
  document.getElementById('password-input').focus();
}

function doLogin() {
  const pass = document.getElementById('password-input').value;
  const err = document.getElementById('login-error');
  if (selectedRole === 'admin' && pass === state.adminPass) {
    state.currentRole = 'admin';
    showAdminApp();
  } else if (selectedRole === 'tenant' && pass === state.tenantPass) {
    state.currentRole = 'tenant';
    showTenantApp();
  } else {
    err.classList.add('show');
    document.getElementById('password-input').value = '';
    setTimeout(() => err.classList.remove('show'), 3000);
  }
}

document.getElementById('password-input').addEventListener('keydown', e => { if(e.key==='Enter') doLogin(); });

// ==================== SCREENS ====================
function showScreen(id) {
  document.querySelectorAll('.screen,.app-shell').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}

function showAdminApp() {
  showScreen('app-admin');
  renderAll();
  switchTab('home');
}

function showTenantApp() {
  showScreen('app-tenant');
  renderTenantIssues();
}

function logout() {
  selectedRole = null;
  document.getElementById('password-input').value = '';
  document.getElementById('password-input').style.display = 'none';
  document.getElementById('login-btn').style.display = 'none';
  document.getElementById('role-admin').classList.remove('selected');
  document.getElementById('role-tenant').classList.remove('selected');
  showScreen('screen-login');
}

// ==================== TABS ====================
function switchTab(tab) {
  ['home','issues','suppliers','payments','settings'].forEach(t => {
    document.getElementById('page-'+t).style.display = t===tab ? 'block' : 'none';
    const nav = document.getElementById('nav-'+t);
    if(nav) {
      nav.classList.toggle('active', t===tab);
      const dot = nav.querySelector('.nav-dot');
      if(dot) dot.style.display = t===tab ? 'block' : 'none';
    }
  });
  if(tab==='issues') renderIssues(state.issueFilter);
}

// ==================== RENDER ====================
function renderAll() {
  renderHomeIssues();
  renderIssues('all');
  renderSuppliers();
  renderPayments();
  updateStats();
}

function updateStats() {
  document.getElementById('stat-open').textContent = state.issues.filter(i=>i.status==='open').length;
  document.getElementById('stat-prog').textContent = state.issues.filter(i=>i.status==='in_progress').length;
  const total = state.payments.reduce((s,p)=>s+p.amount,0);
  document.getElementById('stat-money').textContent = '₪'+total.toLocaleString();
}

function issueCardHTML(issue, role) {
  return `<div class="issue-card" onclick="viewIssue(${issue.id})">
    <div class="issue-info">
      <div class="issue-title">${issue.title}</div>
      <div class="issue-meta">📍 ${issue.location}${role==='admin' ? ` · דייר: ${issue.reporter}` : ''} · ${issue.date}</div>
    </div>
    <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px">
      <span class="badge badge-${statusClass[issue.status]}">${statusLabel[issue.status]}</span>
      <span class="issue-arrow">←</span>
    </div>
  </div>`;
}

function renderHomeIssues() {
  const container = document.getElementById('home-issues-list');
  const recent = state.issues.filter(i=>i.status!=='closed').slice(0,3);
  container.innerHTML = recent.length ? recent.map(i=>issueCardHTML(i,'admin')).join('') : '<div style="text-align:center;padding:20px;color:var(--sub);font-size:14px">🎉 אין תקלות פתוחות!</div>';
}

function renderIssues(filter) {
  state.issueFilter = filter;
  const filtered = filter==='all' ? state.issues : state.issues.filter(i=>i.status===filter);
  document.getElementById('issues-list').innerHTML = filtered.length ? filtered.map(i=>issueCardHTML(i,'admin')).join('') : '<div style="text-align:center;padding:30px;color:var(--sub)">אין תקלות</div>';
}

function filterIssues(filter, btn) {
  document.querySelectorAll('.filter-pill').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  renderIssues(filter);
}

function renderSuppliers() {
  document.getElementById('suppliers-list').innerHTML = state.suppliers.map(s=>`
    <div class="supplier-card">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:4px">
        <div class="supplier-name">${serviceIcon[s.service]||'🔨'} ${s.name}</div>
        <span class="chip">${s.service}</span>
      </div>
      <div class="supplier-service">📞 ${s.phone} · ${s.terms}</div>
      <div class="supplier-actions">
        <button class="supplier-btn supplier-btn-call" onclick="showToast('📞 מתקשר ל-${s.phone}...')">📞 התקשר</button>
        <button class="supplier-btn supplier-btn-pay" onclick="openModal('modal-new-payment')">+ תשלום</button>
      </div>
    </div>`).join('');
}

function renderPayments() {
  document.getElementById('payments-list').innerHTML = state.payments.map(p=>`
    <div class="payment-card">
      <div>
        <div style="font-size:14px;font-weight:700">${p.supplier}</div>
        <div style="font-size:12px;color:var(--sub);margin-top:2px">${p.date} · ${p.method}</div>
      </div>
      <div class="payment-amount">₪${p.amount.toLocaleString()}</div>
    </div>`).join('');
}

function renderTenantIssues() {
  const myIssues = state.issues.slice(0,3);
  document.getElementById('tenant-issues-list').innerHTML = myIssues.length ?
    myIssues.map(i=>issueCardHTML(i,'tenant')).join('') :
    '<div style="text-align:center;padding:30px;color:var(--sub);font-size:14px">🎉 אין תקלות פתוחות</div>';
}

// ==================== ISSUE DETAIL ====================
function viewIssue(id) {
  const issue = state.issues.find(i=>i.id===id);
  if(!issue) return;
  state.viewingIssue = id;
  state.previousScreen = state.currentRole==='admin' ? 'app-admin' : 'app-tenant';

  document.getElementById('detail-title').textContent = issue.title;
  document.getElementById('detail-sub').textContent = issue.location + ' · ' + issue.date;

  let html = `<div class="card">
    <div class="info-row"><span class="info-icon">👤</span><span class="info-label">מדווח</span><span class="info-val">${issue.reporter}</span></div>
    <div class="info-row"><span class="info-icon">📍</span><span class="info-label">מיקום</span><span class="info-val">${issue.location}</span></div>
    <div class="info-row"><span class="info-icon">📅</span><span class="info-label">תאריך</span><span class="info-val">${issue.date}</span></div>
    <div class="info-row"><span class="info-icon">📝</span><span class="info-label">תיאור</span><span class="info-val">${issue.desc||'—'}</span></div>
    ${issue.supplier ? `<div class="info-row"><span class="info-icon">🔧</span><span class="info-label">ספק</span><span class="info-val">${issue.supplier}</span></div>`:''}
    ${issue.cost ? `<div class="info-row"><span class="info-icon">💰</span><span class="info-label">עלות</span><span class="info-val">₪${issue.cost}</span></div>`:''}
  </div>`;

  if(state.currentRole==='admin') {
    html += `<div class="card">
      <div style="font-size:13px;font-weight:700;color:var(--sub);margin-bottom:10px">עדכון סטטוס</div>
      <div class="status-btns">
